# Copy to `.env` for local, or use `.env.production` on deploy.

# Backend API (must include /api suffix)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Production example:
# NEXT_PUBLIC_API_URL=https://leiraindia.com/api

# Media CDN (product / blog / video images)
NEXT_PUBLIC_MEDIA_URL=https://media.leiraindia.com

# Canonical site URL (SEO / share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_SITE_URL=https://leiraindia.com

# Sale countdown (optional)
NEXT_PUBLIC_SALE_COUNTDOWN=1
NEXT_PUBLIC_SALE_END_AT=2026-04-30T22:00:00+05:30
NEXT_PUBLIC_SALE_COUNTDOWN_HEADLINE=Big Sale Ends In
